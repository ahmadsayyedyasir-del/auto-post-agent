# ==============================================================================
# AI Social Media Automation Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the variables accordingly.
# IMPORTANT: Never commit the actual .env file or real secrets to version control.

# ------------------------------------------------------------------------------
# 1. Application & Server Settings (Phase 1)
# ------------------------------------------------------------------------------
APP_NAME="AI Social Media Automation Platform"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. LLM Service & Providers (Phase 2)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=
LLM_MAX_RETRIES=3

# Additional Future LLM Providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. Search & Research APIs (Phase 3)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
SEARCH_MAX_RETRIES=2
# SERPAPI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Planning Agent Configuration (Phase 4)
# ------------------------------------------------------------------------------
PLANNING_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 5. Database Configuration (Future Phase)
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/app.db
# POSTGRES_URL=postgresql://user:password@localhost:5432/social_ai_db

# ------------------------------------------------------------------------------
# 6. Social Media Publishing Credentials (Phase 10: LinkedIn)
# ------------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_API_VERSION=202401
PUBLISHING_MAX_RETRIES=3
PUBLISHING_BASE_BACKOFF_SECONDS=1.0

# Future Platforms (Phase 11+)
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

# ------------------------------------------------------------------------------
# 7. Social Media Scheduling & Automation (Phase 11)
# ------------------------------------------------------------------------------
SCHEDULER_MISFIRE_GRACE_TIME_SECONDS=900
SCHEDULER_STARTUP_RECOVERY_ENABLED=true

# ------------------------------------------------------------------------------
# 8. Authentication, JWT & Platform Credential Encryption (Phase 12)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
